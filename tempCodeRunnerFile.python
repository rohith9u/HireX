import tkinter as tk
from tkinter import messagebox

# -------- Opcode Table --------
opcode = {
    "ADD": "0000", "SUB": "0001", "MOV": "0010",
    "AND": "0011", "OR": "0100", "XOR": "0101",
    "MUL": "0110", "DIV": "0111", "NOT": "1000",
    "CMP": "1001", "LSL": "1010", "LSR": "1011",
    "ASR": "1100", "LD": "1101", "ST": "1110",
    "B": "1111", "BEQ": "1110", "BGT": "1101"
}

register = {
    "R0": "000", "R1": "001", "R2": "010", "R3": "011",
    "R4": "100", "R5": "101", "R6": "110", "R7": "111"
}

labels = {}

# -------- First Pass --------
def store_labels(program):
    labels.clear()
    instruction_index = 0
    for line in program:
        if ":" in line:
            label, *rest = line.split(":")
            labels[label.strip()] = instruction_index
            if rest and rest[0].strip() != "":
                instruction_index += 1
        else:
            instruction_index += 1


# -------- Encoder --------
def encode_instruction(instr, line_no):
    parts = instr.split()
    if not parts:
        return ""

    op = parts[0]

    try:
        if op in ["ADD","SUB","AND","OR","XOR","MUL","DIV","CMP"]:
            return opcode[op] + register[parts[1]] + register[parts[2]] + register[parts[3]]

        elif op == "NOT":
            return opcode[op] + register[parts[1]] + register[parts[2]] + "000"

        elif op in ["LSL","LSR","ASR"]:
            imm = int(parts[3])
            return opcode[op] + register[parts[1]] + register[parts[2]] + format(imm, '03b')

        elif op == "MOV":
            imm = int(parts[2])
            return opcode[op] + register[parts[1]] + format(imm, '06b')

        elif op in ["LD","ST"]:
            addr = int(parts[2])
            return opcode[op] + register[parts[1]] + format(addr, '06b')

        elif op in ["B","BEQ","BGT"]:
            target = parts[1]
            if target.isdigit():
                offset = int(target)
            else:
                offset = labels[target] - line_no - 1
            return opcode[op] + format(offset & 0x1FF, '09b')

        else:
            return "Invalid Instruction"

    except:
        return "Error"


# -------- Compile Function --------
def compile_code():
    code = input_text.get("1.0", tk.END).strip().upper().split("\n")

    store_labels(code)

    output_text.delete("1.0", tk.END)

    instruction_index = 0

    for line in code:
        if ":" in line:
            parts = line.split(":")
            if len(parts) > 1 and parts[1].strip() != "":
                line = parts[1].strip()
            else:
                continue

        result = encode_instruction(line, instruction_index)
        output_text.insert(tk.END, result + "\n")

        instruction_index += 1


# -------- GUI --------
root = tk.Tk()
root.title("SimpleRISC Compiler")
root.geometry("800x600")

# Input Label
tk.Label(root, text="Enter Assembly Code:", font=("Arial", 12)).pack()

# Input Text Area
input_text = tk.Text(root, height=15, width=90)
input_text.pack()

# Compile Button
tk.Button(root, text="Compile", command=compile_code, bg="green", fg="white").pack(pady=10)

# Output Label
tk.Label(root, text="Machine Code Output:", font=("Arial", 12)).pack()

# Output Text Area
output_text = tk.Text(root, height=15, width=90, bg="black", fg="lime")
output_text.pack()

root.mainloop()